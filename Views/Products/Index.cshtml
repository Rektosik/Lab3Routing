@model IEnumerable<ProductsWithRouting.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h2>Products List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Product</a>
</p>

<form method="get" asp-action="Index" class="form-inline mb-3">
    <input type="text" name="name" value="@ViewBag.NameFilter" placeholder="Product name..." class="form-control mr-2" />
    <input type="number" step="0.01" name="minPrice" value="@ViewBag.MinPrice" placeholder="Min price" class="form-control mr-2" />
    <input type="number" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="Max price" class="form-control mr-2" />
    <button type="submit" class="btn btn-secondary">Filter</button>
    <a asp-action="Index" class="btn btn-link">Reset</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <a href="/products/@item.Id">View</a> |
                    <a href="/products/edit/@item.Id">Edit</a> |
                    <a href="/products/delete/@item.Id" onclick="return confirm('Are you sure?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>